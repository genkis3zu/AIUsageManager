{
  "Name": "AI Usage Manager",
  "Version": "1.5.1.0",
  "Author": "AI Usage Manager contributors",
  "Description": "AI Usage Manager（トレイアプリ）が取得したClaude・Codex・Grokの使用量と、AnthropicとOpenAIの障害情報を表示します。このプラグイン自身はインターネットに接続しません。",
  "URL": "https://github.com/genkis3zu/AIUsageManager",
  "UUID": "io.github.genkis3zu.aiusagemanager",
  "CodePath": "bin/plugin.cjs",
  "Nodejs": { "Version": "24" },
  "SDKVersion": 2,
  "Software": { "MinimumVersion": "7.6" },
  "OS": [{ "Platform": "windows", "MinimumVersion": "10" }],
  "Category": "AI Usage Manager",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin",
  "Actions": [
    {
      "UUID": "io.github.genkis3zu.aiusagemanager.claude",
      "Name": "Claude 使用量",
      "Tooltip": "Claudeの使用量を表示します",
      "Icon": "imgs/action",
      "Controllers": ["Keypad"],
      "PropertyInspectorPath": "ui/settings.html",
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/key", "ShowTitle": false }]
    },
    {
      "UUID": "io.github.genkis3zu.aiusagemanager.codex",
      "Name": "Codex 使用量",
      "Tooltip": "Codexの週の使用量を表示します",
      "Icon": "imgs/action",
      "Controllers": ["Keypad"],
      "PropertyInspectorPath": "ui/settings.html",
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/key", "ShowTitle": false }]
    },
    {
      "UUID": "io.github.genkis3zu.aiusagemanager.grok",
      "Name": "Grok 使用量",
      "Tooltip": "Grokの週の使用量を表示します",
      "Icon": "imgs/action",
      "Controllers": ["Keypad"],
      "PropertyInspectorPath": "ui/settings.html",
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/key", "ShowTitle": false }]
    },
    {
      "UUID": "io.github.genkis3zu.aiusagemanager.status",
      "Name": "AIの状況",
      "Tooltip": "AnthropicとOpenAIの障害情報と、週の枠のリセットを表示します。押すと障害情報のページを開きます",
      "Icon": "imgs/action",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/key", "ShowTitle": false }]
    },
    {
      "UUID": "io.github.genkis3zu.aiusagemanager.waiting",
      "Name": "対応待ち",
      "Tooltip": "Claude と Codex のうち、返事を待っているものを表示します。押すと、いちばん長く待たせているアプリを開きます",
      "Icon": "imgs/action",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/key", "ShowTitle": false }]
    },
    {
      "UUID": "io.github.genkis3zu.aiusagemanager.nowdoing",
      "Name": "いまやってること",
      "Tooltip": "押すと小さな窓を開き、入れた1行を今日の日誌の日中ログに書きます",
      "Icon": "imgs/action",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "States": [{ "Image": "imgs/key", "ShowTitle": false }]
    }
  ]
}
